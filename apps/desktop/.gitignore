# Build outputs
src-tauri/target/

# Tauri generated schemas
src-tauri/gen/

# Runtime staging: generated by scripts/prepare-runtime.mjs, never committed
# (portable node tarball cache lives outside, in .runtime-cache/)
runtime/*
!runtime/README.md

# Generated by build-standalone.mjs, removed after each build
scripts/standalone-tauri.json

# Node runtime tarball cache (downloaded distributions)
.runtime-cache/

# Mirrored runtime staging (generated by build-standalone.mjs)
src-tauri/resources/
