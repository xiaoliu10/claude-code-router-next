{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "quota",
  "description": "Only trusted local desktop views can invoke narrowly scoped commands; no remote origins are granted access",
  "windows": [
    "quota",
    "main"
  ],
  "permissions": [
    "allow-quota-snapshot",
    "allow-quota-hide",
    "allow-quota-open-ui",
    "allow-quota-quit",
    "allow-routing-snapshot",
    "allow-routing-save",
    "allow-routing-flags",
    "allow-usage-snapshot",
    "allow-clients-snapshot",
    "allow-clients-update",
    "allow-projects-snapshot",
    "allow-projects-add",
    "allow-projects-save",
    "allow-projects-takeover",
    "allow-projects-delete",
    "allow-service-snapshot",
    "allow-service-action"
  ]
}
