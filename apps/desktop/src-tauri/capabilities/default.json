{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "quota",
  "description": "Only the trusted local quota panel can invoke the four narrow desktop commands",
  "windows": [
    "quota"
  ],
  "permissions": [
    "allow-quota-snapshot",
    "allow-quota-hide",
    "allow-quota-open-ui",
    "allow-quota-quit"
  ]
}
